# Plain KEY=VALUE; no shell expansion. Never commit .env.
STACK_NAME=caveman-stack
IMAGE=localhost/caveman-stack:dev
# Userspace network avoids host bridge/forwarding firewall dependencies.
NETWORK=slirp4netns
BUILD_NETWORK=slirp4netns
# Publish client API on all IPv4 interfaces; use a specific LAN IP to narrow it.
# Ports avoid the existing server's 8787 and 10100.
BIND_ADDRESS=0.0.0.0
PORT=18787
# Authenticated management UI. Empty ADMIN_PORT disables publishing.
# Empty ADMIN_BIND_ADDRESS follows BIND_ADDRESS; 127.0.0.1 limits it to this host.
ADMIN_BIND_ADDRESS=
ADMIN_PORT=20100
MAX_REQUEST_BYTES=268435456
CAVEMAN_MODE=compress
# Optional socket-source filter; rootless port forwarding can replace source IP.
# Configure host firewall CIDRs as the primary network boundary.
ALLOWED_CIDRS=
# Runtime proxy (credentials may go here; file is chmod 600).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Mount PEM/CRT corporate certificates in certs/. No TLS verification bypass.
# Optional inbound TLS: certs/server.crt and secrets/server.key
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Catalog refreshes once at startup. For later changes, run ./stack catalog.
