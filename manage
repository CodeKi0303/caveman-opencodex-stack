#!/bin/sh
# Keep this launcher dependency-free; bootstrap selects a native Linux runtime.
set -eu
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'Python 3.11 이상이 필요합니다. Linux/WSL에서 python3를 설치한 뒤 ./manage를 다시 실행하세요.' >&2
  exit 1
fi
CAVEMAN_REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec python3 "$CAVEMAN_REPO_DIR/scripts/bootstrap.py" "$@"
